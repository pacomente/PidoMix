# Copiá este archivo como .env y completalo. El .env nunca se sube al repositorio.

# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel → Docker: el valor después de --token)
TUNNEL_TOKEN=

# Modelo de Ollama (tiene que soportar herramientas): qwen2.5:7b recomendado; qwen2.5:3b si el servidor es chico
AI_MODEL=qwen2.5:7b
