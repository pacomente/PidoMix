{
  "expo": {
    "name": "Trappi",
    "slug": "trappi",
    "scheme": "trappi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C2BD9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.trappi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.trappi.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C2BD9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trappi usa tu ubicación para mostrarte qué comercios llegan hasta vos y calcular el envío.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://pidomix-1.onrender.com"
    }
  }
}
