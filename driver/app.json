{
  "expo": {
    "name": "Trappi Repartidor",
    "slug": "trappi-repartidor",
    "scheme": "trappirepartidor",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.trappi.repartidor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "ar.trappi.repartidor",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "WAKE_LOCK",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trappi Repartidor usa tu ubicación mientras estás conectado para ofrecerte viajes cercanos y mostrarte el recorrido.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#06C167",
          "defaultChannel": "ofertas",
          "sounds": [
            "./assets/sounds/trappi_repartidor_nuevo.wav",
            "./assets/sounds/trappi_repartidor_aceptado.wav"
          ]
        }
      ],
      "@sentry/react-native/expo",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Trappi Repartidor usa la cámara para la foto de prueba de la entrega y para mandar fotos en el chat del pedido.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Trappi Repartidor usa el micrófono solo mientras mantenés apretado el botón del asistente, para entender lo que le pedís.",
          "speechRecognitionPermission": "Trappi Repartidor pasa tu voz a texto para que el asistente entienda lo que le pedís.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://trappi.com.ar",
      "sentryDsn": ""
    }
  }
}
